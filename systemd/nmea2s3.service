# nmea2s3 — install to /etc/systemd/system/nmea2s3.service
#
#   sudo pipx install --global --force git+https://github.com/ghotihook/nmea2s3.git
#     (--force on every install: pipx upgrade compares version numbers, so
#      commits that did not bump `version` look to it like nothing to do)
#   sudo install -Dm600 env /etc/nmea2s3/env
#   sudo install -m644 nmea2s3.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nmea2s3
#
# Nothing to replace. Runs as root; --global puts the command in
# /usr/local/bin. A per-user pipx install puts it in ~/.local/bin instead.

[Unit]
Description=nmea2s3 — NMEA 2000 raw capture logger (SocketCAN -> S3)

# Ordering only, no Wants= — both can wait forever on a boat with no
# internet, and the logger needs neither: it spools to disk and uploads later.
After=network-online.target time-sync.target

# Never stop restarting. The default limit (5 starts in 10s) parks the unit in
# `failed` for good, which for a logger is silent permanent data loss.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/nmea2s3/env

# Creates /var/lib/nmea2s3, the only path this sandbox can write. The spool
# path is passed on the command line below, not as an environment variable:
# EnvironmentFile= always overrides Environment=, so the env file would get
# the last word and could send the spool somewhere writing fails. To move the
# spool: change --disk-dir AND add a ReadWritePaths= for the new path — both,
# or it cannot write there.
StateDirectory=nmea2s3

# Binding to a DOWN can0 succeeds and captures nothing, so bring it up first.
# Idempotent — can0 is shared with n2k2ip.
ExecStartPre=/bin/sh -c 'ip link show can0 | grep -qw UP || ip link set can0 up type can bitrate 250000 restart-ms 100 2>/dev/null; ip link show can0 | grep -qw UP'

ExecStart=/usr/local/bin/nmea2s3-logger --can can0 --disk-dir /var/lib/nmea2s3
SyslogIdentifier=nmea2s3
Restart=always
RestartSec=5
TimeoutStopSec=90

# Root, so the sandbox is what limits the blast radius: /usr and /etc are
# read-only, /home and /root are read-only, and StateDirectory above is the
# only place this can write.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

# Runaway backstop, not a capacity limit: measured worst case is 191M at the
# 48M buffer cap. Must stay clear of it — this kills, the app cap just sheds.
MemoryMax=512M

# Lower than everything else on the box (n2k2ip is -700): a missed frame does
# not exist anywhere, other services' traffic can be re-read.
OOMScoreAdjust=-900
CPUWeight=200

[Install]
WantedBy=multi-user.target
