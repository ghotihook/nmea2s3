# nmea2s3 configuration. Copy to `env` (no leading dot — kept visible in a
# plain `ls` on purpose) and fill in real values. `env` is gitignored; this
# template is the only one that is committed, so no credential ever reaches
# the repo.
#
# PLAIN `KEY=value` lines, NO `export`. systemd's EnvironmentFile= parser does
# not strip a leading `export` — it rejects the whole line, one warning per
# line in the journal, and the service starts with none of its environment:
#
#   Ignoring invalid environment assignment 'export NMEA2S3_S3_BUCKET=...'
#
# which is how the logger once came up with no S3 credentials at all. The
# format has to suit systemd, because systemd is the reader that fails
# silently: a shell tells you immediately, a unit just carries on without it.
#
# In a shell, `source env` on its own sets shell variables WITHOUT exporting
# them to child processes, so use:
#
#   set -a; source env; set +a

# ── Required ─────────────────────────────────────────────────────────────

# The REGION endpoint, not the bucket's virtual-hosted URL — the bucket name
# goes in NMEA2S3_S3_BUCKET only. e.g. for a DigitalOcean Space at
# https://mybucket.syd1.digitaloceanspaces.com, that is
# bucket=mybucket, region=syd1, endpoint=https://syd1.digitaloceanspaces.com.
NMEA2S3_S3_ENDPOINT_URL=https://syd1.digitaloceanspaces.com
NMEA2S3_S3_BUCKET=changeme

# Passed explicitly to boto3 rather than relying on its standard
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY auto-discovery — see make_s3_client()
# in ndjson.py. Give the logger a key that can PUT and cannot DELETE: the
# archive is the source of truth and nothing here ever needs to remove an
# object, so a credential that cannot delete makes an accident impossible
# rather than merely unlikely.
NMEA2S3_S3_ACCESS_KEY_ID=changeme
NMEA2S3_S3_SECRET_ACCESS_KEY=changeme

# ── Optional ─────────────────────────────────────────────────────────────

# DO Spaces ignores the region, boto3 requires one. Default: us-east-1.
#NMEA2S3_S3_REGION=us-east-1

# NMEA2S3_DISK_DIR — the spool directory — is deliberately NOT here. The unit
# passes --disk-dir, which wins over this file, so a value here would be
# ignored under systemd and misleading everywhere else. Move the spool in the
# unit instead. Outside systemd the variable still works.

# DEBUG, INFO, WARNING, ERROR or CRITICAL. Default INFO; --log-level wins.
#NMEA2S3_LOG_LEVEL=INFO

# ── nmea2s3-migrate-n0183 only ────────────────────────────────────────────
#
# The LEGACY database the 0183 history is imported FROM. Read-only as far as
# this tool is concerned, and it is the last copy of that data — which is why
# it does not share the NMEA2S3_PG_* names below. Those point at the derived
# table update-pg is free to drop and rebuild; these point at something that
# cannot be regenerated, and one set of names for both would let a mistyped
# host send an importer at the derived database or a rebuild at the source.
#
# The logger never reads these, and never needs them.
#NMEA2S3_SRC_PG_HOST=changeme
#NMEA2S3_SRC_PG_PORT=5432
#NMEA2S3_SRC_PG_DBNAME=changeme
#NMEA2S3_SRC_PG_USER=changeme
#NMEA2S3_SRC_PG_PASSWORD=changeme

# ── nmea2s3-update-pg only ────────────────────────────────────────────────
#
# The destination for the wide table. This database is DERIVED and
# disposable — everything in it is rebuildable from the archive, which is
# what makes it safe for the tool to alter its own schema. Do not point it
# at a database holding anything that cannot be regenerated.
#
# The logger never reads these, and never needs them.
#NMEA2S3_PG_HOST=changeme
#NMEA2S3_PG_PORT=5432
#NMEA2S3_PG_DBNAME=changeme
#NMEA2S3_PG_USER=changeme
#NMEA2S3_PG_PASSWORD=changeme
